# ─────────────────────────────────────────
#  SkillBridge — Backend Environment Variables
#  Copy this file to .env and fill in your values.
#  Never commit your actual .env file!
# ─────────────────────────────────────────

# Server
PORT=5000

# MongoDB
# Cloud Atlas URI (recommended for production):
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/skillbridge?retryWrites=true&w=majority

# Auth
# Generate a strong random secret, e.g.: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# CORS (comma-separated list of allowed frontend origins)
ALLOWED_ORIGINS=http://localhost:5173
